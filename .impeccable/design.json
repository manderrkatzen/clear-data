      "css": ".ds-approval{font:600 14px var(--font-ui,\"Source Sans 3\",sans-serif);min-height:44px;padding:9px 15px;border:1px solid var(--green,#176146);border-radius:var(--radius,6px);background:var(--green,#176146);color:white;box-shadow:none;cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease}.ds-approval:hover{background:#104b35}.ds-approval:focus-visible{outline:3px solid #83a9f1;outline-offset:3px}.ds-approval:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-approval{transition:none}}"
