  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared blue primary action; Review Apply uses this 40px-minimum native button after consequences, risk, preview, and acknowledgements.",
      "html": "<button class=\"ds-primary\">Apply</button>",
      "css": ".ds-primary{font:600 14px var(--font-ui,\"Source Sans 3\",sans-serif);min-height:40px;padding:9px 15px;border:1px solid var(--blue,#245bc5);border-radius:var(--radius,6px);background:var(--blue,#245bc5);color:white;box-shadow:none;cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease}.ds-primary:hover:not(:disabled){background:#1b49a4;border-color:#1b49a4}.ds-primary:focus-visible{outline:3px solid #83a9f1;outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Review Task and Tabs",
      "kind": "custom",
      "refersTo": "review-task",
      "description": "White task surface with native Explore / Fix / Review tabs. Source uses a 280px grouped issue list beside it, independent desktop scrolling, and stacked layout at 900px. This snippet is a visual specimen, not executable review logic.",
      "html": "<section class=\"ds-task\"><header><h1>delivery_days</h1><p>Missing values · 86 cells (8.6%)</p></header><nav class=\"ds-tabs\" role=\"tablist\" aria-label=\"Issue review\"><button role=\"tab\" aria-selected=\"true\">Explore</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Fix</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" disabled title=\"Apply a fix to see changes\">Review</button></nav><p class=\"ds-task-copy\">Read the missing rows beside similar complete rows.</p></section>",
      "css": ".ds-task{min-width:0;background:white;border-radius:8px;padding:22px 26px 20px;color:var(--ink,#182b43);font:15px/1.5 var(--font-ui,\"Source Sans 3\",sans-serif);font-variant-numeric:tabular-nums}.ds-task header{margin-bottom:18px}.ds-task h1{font-size:23px;font-weight:600;letter-spacing:-.35px;margin:0 0 4px}.ds-task header p{font-size:14px;color:var(--muted,#52647a);margin:0}.ds-tabs{display:flex;gap:28px;border-bottom:1px solid var(--line,#d9e1eb)}.ds-tabs button{border:0;border-bottom:2px solid transparent;border-radius:0;background:none;padding:9px 0 11px;color:var(--muted,#52647a);font:600 14px var(--font-ui,\"Source Sans 3\",sans-serif);cursor:pointer}.ds-tabs button[aria-selected=true]{border-bottom-color:#2E6BD9;color:#245bc5}.ds-tabs button:focus-visible{outline:3px solid #83a9f1;outline-offset:3px}.ds-tabs button:disabled{opacity:.5;cursor:not-allowed}.ds-task-copy{padding-top:18px;font-size:14px;line-height:1.55}@media(max-width:620px){.ds-task{padding:18px 14px}.ds-task h1{font-size:21px}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White bordered supporting action.",
      "html": "<button class=\"ds-secondary\">Column definitions</button>",
      "css": ".ds-secondary{font:600 14px var(--font-ui,\"Source Sans 3\",sans-serif);min-height:40px;padding:9px 15px;border:1px solid #becbdc;border-radius:var(--radius,6px);background:white;color:#274469;box-shadow:none;cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease}.ds-secondary:hover:not(:disabled){background:#f0f4fc;border-color:#809abd}.ds-secondary:focus-visible{outline:3px solid #83a9f1;outline-offset:3px}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Incumbent low-emphasis shell action; Review uses separate compact text actions.",
      "html": "<button class=\"ds-ghost\">Undo last change</button>",
      "css": ".ds-ghost{font:600 14px var(--font-ui,\"Source Sans 3\",sans-serif);min-height:40px;padding:9px 15px;border:0;border-radius:var(--radius,6px);background:transparent;color:var(--muted,#52647a);box-shadow:none;cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease}.ds-ghost:hover:not(:disabled){background:#edf2f8;color:var(--ink,#182b43)}.ds-ghost:focus-visible{outline:3px solid #83a9f1;outline-offset:3px}.ds-ghost:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
    },
    {
      "name": "Review Field",
      "kind": "input",
      "refersTo": "input-review",
      "description": "Native Review input with root line border, 8px 10px padding, 36px minimum height, and inherited keyboard focus.",
      "html": "<label class=\"ds-field-label\">Replacement value<input class=\"ds-field\" placeholder=\"Replacement value\"></label>",
      "css": ".ds-field-label{display:grid;gap:6px;font:13px/1.5 var(--font-ui,\"Source Sans 3\",sans-serif);color:var(--ink,#182b43)}.ds-field{min-width:0;max-width:100%;min-height:36px;border:1px solid var(--line,#d9e1eb);border-radius:6px;padding:8px 10px;font:14px/1.5 var(--font-ui,\"Source Sans 3\",sans-serif);color:var(--ink,#182b43);background:white}.ds-field::placeholder{color:var(--muted,#52647a);opacity:1}.ds-field:focus-visible{outline:3px solid #83a9f1;outline-offset:3px}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Native navigation button with SVG; active state shown. Compact horizontal layout begins at 800px in the application shell.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Primary navigation\"><button class=\"ds-nav ds-nav-active\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18M3 14h18M9 4v16\"/></svg>Explore</button><button class=\"ds-nav\">Review</button><button class=\"ds-nav\" disabled>Report</button></nav>",
      "css": ".ds-rail{display:grid;gap:5px;background:var(--rail,#172d4b);padding:16px}.ds-nav{display:flex;align-items:center;gap:12px;width:100%;min-height:46px;padding:11px 12px;border:0;border-radius:var(--radius,6px);background:transparent;text-align:left;color:#c1d0e5;font:600 15px var(--font-ui,\"Source Sans 3\",sans-serif);cursor:pointer}.ds-nav svg{width:18px;height:18px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-nav:hover{background:#233c5d;color:white}.ds-nav.ds-nav-active{background:#2b4c79;color:white}.ds-nav:focus-visible{outline:3px solid #83a9f1;outline-offset:3px}.ds-nav:disabled{color:#a8bad4;opacity:1;cursor:not-allowed}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "status-neutral",
      "description": "Noninteractive neutral, warning, and success visual variants; text defines the actual application meaning.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge\">Original</span><span class=\"ds-badge ds-warning\">Unresolved</span><span class=\"ds-badge ds-success\">Approved</span></div>",
      "css": ".ds-badges{display:flex;flex-wrap:wrap;gap:8px}.ds-badge{border-radius:4px;font:600 12px var(--font-ui,\"Source Sans 3\",sans-serif);padding:4px 8px;background:#edf1f7;color:#4b5f7b}.ds-warning{color:#765019;background:var(--amber-bg,#fff4df)}.ds-success{color:#1f6448;background:#e8f6ee}"
    },
    {
      "name": "Workspace Card",
      "kind": "card",
      "refersTo": "workspace-card",
      "description": "Flat white native section for contextual analytical content.",
      "html": "<section class=\"ds-card\"><h2>Give the copilot context</h2><p>Describe what the data measures to improve subsequent suggestions.</p></section>",
      "css": ".ds-card{margin:22px 0;padding:20px;border:1px solid var(--line,#d9e1eb);border-radius:8px;background:var(--panel,#ffffff);color:var(--ink,#182b43);font:15px/1.5 var(--font-ui,\"Source Sans 3\",sans-serif)}.ds-card h2{margin:0 0 8px;font-size:19px;font-weight:600}.ds-card p{color:var(--muted,#52647a);font-size:14px;line-height:1.6}@media(max-width:560px){.ds-card{padding:18px}}"
    },
    {
      "name": "SVG Finding Marker",
      "kind": "custom",
      "description": "Potential-outlier category marker; exact SVG path data from sheetSvgIcon. Category encoding is not a severity verdict.",
      "html": "<button class=\"ds-finding\" aria-label=\"Potential outlier, 3 flagged cells\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"6\" cy=\"16\" r=\"2\"/><circle cx=\"11\" cy=\"13\" r=\"2\"/><circle cx=\"18\" cy=\"6\" r=\"3\"/></svg><small>3</small></button>",
      "css": ".ds-finding{display:inline-flex;align-items:center;justify-content:center;gap:2px;min-width:24px;height:26px;padding:2px 4px;border:1px solid #7544a7;border-radius:6px;background:#f3edfa;color:#7544a7;font:700 14px var(--font-ui,\"Source Sans 3\",sans-serif);cursor:pointer}.ds-finding svg{width:16px;height:16px;flex-shrink:0;vertical-align:middle}.ds-finding small{margin-left:2px;font-size:10px}.ds-finding:focus-visible{outline:2px solid #7544a7;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Analytical Review Desk",
    "overview": "ClearData is a precise, daylight analytical workspace. An ink-navy navigation rail frames white task surfaces on cool paper; blue identifies actions and selection. Review evidence pairs orange before/missing/flagged values with blue after/present/normal values and grey neutral values. The character is restrained and information-led: readable data, aligned labels, compact controls, and meaningful hairline divisions.\n\nThe system uses native browser controls, inline SVG icons, and a self-hosted typeface. Review combines a column-grouped issue list with a bounded white task surface and Explore / Fix / Review tabs. Fix puts reported-number consequences and an explicitly named risk before its compact preview and common Apply action; Review exposes the recorded result and Undo.",
    "keyCharacteristics": [
      "Navy navigation, white task surfaces, and cool-paper surroundings.",
      "Source Sans 3 with tabular numerals for analytical comparisons.",
      "Blue actions and selection; orange/blue Review evidence with grey neutral values.",
      "Restrained corners, hairline divisions, and SVG finding icons.",
      "Native controls, freely navigable issue tabs, and shared Apply / Undo actions."
    ],
    "rules": [
      { "name": "The Meaning Before Color Rule", "body": "Pair semantic color with visible labels, icons, counts, or evidence; a flagged value is a finding for review, not proof that it is invalid.", "section": "colors" },
      { "name": "The Evidence Before Apply Rule", "body": "Show the reported-number consequence and explicit risk before the compact preview. Keep Apply after evidence and acknowledgements, and Undo with the recorded result; action footers must not obscure scrolling content.", "section": "elevation" }
    ],
    "dos": [
      "Do use Source Sans 3 and tabular numerals for analytical data.",
      "Do use orange before/missing/flagged, blue after/present/normal, and grey neutral values in Review evidence; keep risk colors separately labeled.",
      "Do pair finding colors with SVG icons and textual descriptions.",
      "Do preserve common bins and scales in comparisons, including recomposed mobile histograms with legible labels.",
      "Do put consequences and explicit risk before the preview and Apply; keep Undo with the recorded result.",
      "Do account for inherited responsive rules when extending the final visual layer."
    ],
    "donts": [
      "Don't infer a dark theme from the navy navigation rail.",
      "Don't equate a finding color with invalid data or automatic treatment.",
      "Don't replace SVG finding icons with glyph icons or raster images.",
      "Don't promote residual legacy fonts, kickers, or green-selection styling into new system rules.",
      "Don't infer whole-spec acceptance or a whole-surface clean bill from documentation, captures, or a limited finish verdict."
    ]
  }
}
